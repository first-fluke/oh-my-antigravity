# OMA runtime state (hook persistent mode)
.agents/state/
.agents/results/
# .agents/eval/*.yaml task fixtures are tracked SSOT — hand-authored eval inputs
# for `oma skill eval` / `opt` (design-prime-agent-adoption-202608). Do not add
# an ignore rule for the directory itself. They are not shipped to users:
# excluded in cli/generate-manifest.ts, removed from user projects by migration
# 021-remove-eval-artifacts.
#
# _rollouts/ is NOT tracked, for two reasons that outlive any one run:
#   1. Content is a one-off execution log — session ids, per-run cost, cache
#      token counts, the model that happened to answer.
#   2. A recording only replays for the exact SKILL.md body it was made from
#      (RolloutEntry.skillBodyHash, enforced in loadRolloutEntries). Editing a
#      skill invalidates its recordings, so a committed one would go stale on
#      the next SKILL.md change and only emit warnings for everyone who pulls.
# Recording locally and replaying with `--mock` is the supported workflow.
.agents/eval/**/_rollouts/

# oma backups — single gitignored root for migration snapshots, stack copies,
# and safe-write siblings (see cli/io/backup.ts)
.agents/backup/
.migration-backup/   # legacy location (pre-consolidation; no longer written)

# agy (Antigravity) hooks manifest — generated per-install with absolute paths
.agents/hooks.json

# HUD statusline debug dump — written next to the hook dir when OMA_HUD_DEBUG=1
.agents/hooks/last-hud-input.json

# Nested oma artifacts (when build/tests run from cli/ with OMA_HOME unset
# they may write a stray .agents/ under cli/ — never tracked)
cli/.agents/

